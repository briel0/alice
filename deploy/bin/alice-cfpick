#!/bin/sh
# Seletor de problemas do Codeforces pela linha de comando (ex.: sudo /opt/alice/bin/alice-cfpick gym-discover)
set -a
. /etc/alice/alice.env
set +a
export TZ=America/Sao_Paulo LANG=C.UTF-8 PYTHONIOENCODING=utf-8
cd /opt/alice/app && exec runuser -u alice -- /opt/alice/app/.venv/bin/python -m src.cfpick "$@"
