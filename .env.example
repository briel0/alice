# Token do Bot do Telegram gerado via @BotFather
TELEGRAM_BOT_TOKEN=seu_token_aqui

# Chave de API do Google Gemini
GEMINI_API_KEY=sua_chave_gemini_aqui

# ID de usuário do Telegram para segurança (para que apenas você possa interagir com o bot)
ALLOWED_TELEGRAM_USER_ID=seu_telegram_user_id

# Como a ALICE chama você (opcional)
USER_NAME=

# Modelo do Gemini (opcional)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Planner (opcional): API onde a ALICE cria cartões de projetos (ex.: http://127.0.0.1:8080)
# PLANNER_API_URL=
# PLANNER_INBOX_CATEGORY=Inbox

# Treinos (opcional): API onde a ALICE registra treinos e peso corporal (ex.: http://127.0.0.1:5265)
# TREINOS_API_URL=
