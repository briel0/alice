# Token do Bot do Telegram gerado via @BotFather
TELEGRAM_BOT_TOKEN=seu_token_aqui

# Chave de API do Google Gemini
GEMINI_API_KEY=sua_chave_gemini_aqui

# ID de usuário do Telegram para segurança (para que apenas você possa interagir com o bot)
ALLOWED_TELEGRAM_USER_ID=seu_telegram_user_id

# Como a ALICE chama você (opcional)
USER_NAME=

# Modelo do Gemini (opcional)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Planner (opcional): API onde a ALICE cria cartões de projetos (ex.: http://127.0.0.1:8080)
# PLANNER_API_URL=
# PLANNER_INBOX_CATEGORY=Inbox

# Treinos (opcional): API onde a ALICE registra treinos e peso corporal (ex.: http://127.0.0.1:5265)
# TREINOS_API_URL=

# Codeforces (opcional): sorteio de problemas para treino de ICPC
# CF_HANDLE=
# Só para montar o catálogo de gyms (python -m src.cfpick gym-discover); gere em codeforces.com/settings/api
# CF_API_KEY=
# CF_API_SECRET=

# Filtro de e-mails (opcional): sem os dois primeiros, não roda. Passo a passo em deploy/README.md.
# Token gerado por scripts/gmail_autorizar.py (só leitura do Gmail); fica fora do repositório
# NOTIF_GMAIL_TOKEN_PATH=/run/credentials/alice.service/gmail-token.json
# Chave do Gemini de OUTRO projeto do Google, só para o classificador
# NOTIF_GEMINI_API_KEY=
# NOTIF_GEMINI_MODEL=
# NOTIF_GEMINI_LIMITE_DIA=150
# NOTIF_DB_PATH=/var/lib/alice/notificacoes.db
# Modo sombra da primeira semana (1 = alertas marcados com 🧪); 0 depois de conferir o balanço
# NOTIF_SOMBRA=1
